{
  "name": "recompute",
  "version": "0.1.0",
  "private": true,
  "description": "Recompute: old school devices pool their compute into a private classroom AI lab. Rethink. Reuse. Recompute.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
