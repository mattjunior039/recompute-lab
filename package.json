    "onnxruntime-web": "^1.31.1",
    "protobufjs": "^8.8.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattjunior039/recompute-lab.git"
  },
